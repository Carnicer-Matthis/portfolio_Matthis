---
// Le formulaire est géré par Netlify Forms : Netlify repère le formulaire au déploiement
// (attribut data-netlify) et range les messages dans le tableau de bord du site (onglet Forms).
---

<section id="contact" class="w-full bg-neutres-blanc-casse pt-4 pb-16 sm:pb-20 md:pb-28">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-6">

      <div data-reveal class="lg:col-span-5 flex flex-col">
        <h2 class="font-londrina font-normal text-[44px] sm:text-[54px] md:text-t1 leading-none text-neutres-gris-fonce uppercase">
          Contactez-moi
        </h2>

        <div data-reveal="bar" class="w-20 sm:w-24 h-0.75 bg-marque-orange rounded-full mt-3"></div>

        <p class="font-sans text-[14px] leading-5 text-texte-attenue max-w-[320px] mt-6">
          Un projet, une question, une idée à confronter ? Écrivez-moi, je réponds rapidement.
        </p>

        <div class="mt-6">
          <a
            href="/CV_Matthis_CARNICER.pdf"
            download="CV_Matthis_CARNICER.pdf"
            class="inline-flex items-center gap-2 rounded-full bg-marque-orange px-5 py-1.5 font-londrina text-[20px] leading-7 text-texte-principal transition-opacity hover:opacity-85"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14" />
            </svg>
            Télécharger mon CV
          </a>
        </div>
      </div>

      <form
        data-reveal
        style="--reveal-delay: 150ms"
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="lg:col-span-7 flex flex-col gap-4 p-6 bg-surfaces-blanc/50 border-[0.8px] border-bordures-claires rounded-[10px]"
      >
        <!-- Champs techniques pour Netlify : nom du formulaire + piège anti-spam invisible -->
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <label class="flex flex-col gap-1">
          <span class="font-sans font-semibold text-[12px] leading-4 tracking-[0.6px] uppercase text-texte-attenue">
            Prénom
          </span>
          <input
            type="text"
            name="prenom"
            required
            autocomplete="given-name"
            placeholder="Votre prénom ..."
            class="field"
          />
        </label>

        <label class="flex flex-col gap-1">
          <span class="font-sans font-semibold text-[12px] leading-4 tracking-[0.6px] uppercase text-texte-attenue">
            Email
          </span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="Votre email ..."
            class="field"
          />
        </label>

        <label class="flex flex-col gap-1">
          <span class="font-sans font-semibold text-[12px] leading-4 tracking-[0.6px] uppercase text-texte-attenue">
            Message
          </span>
          <textarea
            name="message"
            required
            rows="5"
            placeholder="Votre message ..."
            class="field h-[117.6px] resize-y"
          ></textarea>
        </label>

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="inline-flex items-center px-5 py-1.5 rounded-full bg-marque-orange font-londrina font-normal text-[20px] leading-7 text-texte-principal hover:opacity-85 transition-opacity cursor-pointer disabled:opacity-50 disabled:cursor-wait focus:outline-none focus-visible:ring-2 focus-visible:ring-marque-orange focus-visible:ring-offset-2"
          >
            Envoyer
          </button>

          <!-- Message de retour (succès / erreur), lu par les lecteurs d'écran -->
          <p id="contact-status" class="font-sans text-[14px] leading-5" role="status" aria-live="polite"></p>
        </div>
      </form>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-status');

  if (form && statusEl) {
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    const showStatus = (text: string, ok: boolean) => {
      statusEl.textContent = text;
      statusEl.classList.toggle('text-[#3F8F5A]', ok);
      statusEl.classList.toggle('text-[#C2410C]', !ok);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      // Netlify Forms attend les champs encodés comme un formulaire classique
      const body = new URLSearchParams();
      data.forEach((value, key) => body.append(key, String(value).trim()));

      button.disabled = true;
      showStatus('Envoi en cours…', true);

      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        form.reset();
        showStatus('Merci ! Votre message a bien été envoyé.', true);
      } catch (error) {
        console.error('Envoi du message impossible :', error);
        showStatus("Oups, le message n'a pas pu être envoyé. Réessayez plus tard.", false);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  @reference "../styles/global.css";

  /* Style commun des champs */
  .field {
    @apply w-full bg-surfaces-blanc border-[0.8px] border-bordures-claires rounded-md px-3 py-2
      font-sans text-[14px] leading-5 text-neutres-gris-fonce
      placeholder:font-semibold placeholder:tracking-[0.6px] placeholder:text-texte-attenue/60
      focus:outline-none focus:border-marque-orange focus:ring-1 focus:ring-marque-orange transition-colors;
  }
</style>
