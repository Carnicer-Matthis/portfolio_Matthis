---
import { Image } from 'astro:assets';
import githubIcon from '../assets/github.svg';
import linkedinIcon from '../assets/linkedin.svg';
import emailIcon from '../assets/mail.svg';

const navLinks = [
  { name: 'Accueil', href: '/' },
  { name: 'Projets', href: '/projets' },
  { name: 'À propos', href: '/#a-propos' },
  { name: 'Contact', href: '/#contact' },
];

const socials = [
  { label: 'Profil GitHub', href: 'https://github.com/Carnicer-Matthis', icon: githubIcon, external: true },
  { label: 'Profil LinkedIn', href: 'https://www.linkedin.com/in/matthis-carnicer', icon: linkedinIcon, external: true },
  { label: 'Envoyer un e-mail', href: 'mailto:matthiscarnicer@gmail.com', icon: emailIcon, external: false },
];
---

<footer class="w-full bg-surfaces-blanc text-neutres-gris-fonce border-t border-bordures-claires">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 py-8 sm:py-10">

    <!-- Ligne 1 : nom, navigation, réseaux (pictos SVG gris foncé) -->
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <a href="/" class="font-londrina text-[30px] sm:text-[34px] leading-none text-marque-orange hover:opacity-85 transition-opacity">
        Matthis Carnicer
      </a>

      <nav aria-label="Navigation pied de page">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="font-londrina text-[18px] leading-6 hover:text-marque-orange transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ul class="flex items-center gap-3" aria-label="Mes réseaux">
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              aria-label={social.label}
              {...(social.external && { target: '_blank', rel: 'noopener noreferrer' })}
              class="flex size-10 items-center justify-center rounded-full transition hover:bg-marque-orange/15 hover:scale-110"
            >
              <Image src={social.icon} alt="" class="size-6 object-contain" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Ligne 2 : copyright + mentions légales -->
    <div class="mt-6 pt-5 border-t border-bordures-claires flex flex-col gap-2 sm:flex-row sm:justify-between text-[13px] text-texte-attenue">
      <p>© 2026 Matthis Carnicer. Tous droits réservés.</p>
      <a href="/mentions-legales" class="underline underline-offset-2 hover:text-marque-orange transition-colors">
        Mentions légales
      </a>
    </div>

  </div>
</footer>
