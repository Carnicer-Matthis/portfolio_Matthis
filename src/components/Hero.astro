---
import { Image } from 'astro:assets';
import fondImage from '../assets/Fond.webp';
import heroImage from '../assets/image_Hero.webp';
---

<section class="relative w-full h-[calc(100vh-3.5rem)] min-h-[620px] max-h-[960px] overflow-hidden bg-neutres-blanc-casse select-none border-b border-bordures-subtiles">
  
  <!-- Image de fond décorative Fond.webp en pleine largeur -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden select-none">
    <Image
      src={fondImage}
      alt="Arrière-plan Hero"
      priority
      loading="eager"
      class="w-full h-full object-cover object-center"
    />
  </div>

  <!-- Grand Lettering Arrière-plan "MATTHIS" fluide selon la largeur de l'écran (clamp) -->
  <div class="absolute inset-x-0 top-2 sm:top-4 md:top-6 flex justify-center pointer-events-none z-[1] overflow-hidden">
    <h1 class="text-[clamp(4.5rem,17vw,16.5rem)] leading-[0.8] tracking-[0.045em] font-londrina font-normal text-marque-orange uppercase whitespace-nowrap">
      MATTHIS
    </h1>
  </div>

  <!-- Image Détourée Portrait : dimensionnée proportionnellement à la hauteur de l'écran sans distorsion -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 z-10 h-[78%] sm:h-[84%] md:h-[90%] max-h-[820px] pointer-events-none flex justify-center items-end">
    <Image
      src={heroImage}
      alt="Matthis - Portrait"
      priority
      loading="eager"
      class="h-full w-auto max-w-none object-contain object-bottom drop-shadow-[0_10px_32px_rgba(0,0,0,0.25)]"
    />
  </div>

  <!-- Contenu Éditorial Avant-plan (Z-20) adapté au format desktop -->
  <div class="relative z-20 w-full h-full max-w-[1680px] mx-auto flex justify-between pt-[28vh] sm:pt-[32vh] md:pt-[35vh] pb-8 md:pb-12 px-6 sm:px-10 lg:px-16 pointer-events-auto">
    
    <!-- Colonne Gauche : Montbéliard, 2026, En recherche de stage -->
    <div class="flex flex-col justify-between h-full max-w-[140px] sm:max-w-[220px] md:max-w-[280px]">
      <p class="font-londrina font-normal text-[20px] sm:text-[30px] md:text-[38px] lg:text-[44px] leading-none text-marque-orange">
        Montbéliard
      </p>
      
      <p class="font-londrina font-normal text-[20px] sm:text-[30px] md:text-[38px] lg:text-[44px] leading-none text-marque-orange">
        2026
      </p>
      
      <p class="font-londrina font-normal text-[16px] sm:text-[24px] md:text-[32px] lg:text-[40px] leading-[1.05] text-marque-orange">
        En recherche<br />de stage
      </p>
    </div>

    <!-- Colonne Droite : Communication & UI/UX Design, MMI, Scroll -->
    <div class="flex flex-col justify-between items-end text-right h-full max-w-[160px] sm:max-w-[240px] md:max-w-[320px]">
      <p class="font-londrina font-normal text-[16px] sm:text-[24px] md:text-[32px] lg:text-[40px] leading-[1.05] text-marque-orange">
        Communication &<br />UI/UX Design
      </p>
      
      <p class="font-londrina font-normal text-[20px] sm:text-[30px] md:text-[38px] lg:text-[44px] leading-none text-marque-orange">
        MMI
      </p>
      
      <a
        href="#projets"
        class="group inline-flex items-center gap-2 font-londrina font-normal text-[18px] sm:text-[22px] md:text-[24px] leading-none text-marque-orange hover:opacity-80 transition-all pb-1"
        aria-label="Faire défiler vers les projets"
      >
        <span>Scroll</span>
        <svg
          class="w-4 h-4 sm:w-5 sm:h-5 transition-transform group-hover:translate-y-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>

  </div>
</section>
