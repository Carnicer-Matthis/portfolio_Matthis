---
import { Image } from 'astro:assets';
import fondImage from '../assets/Fond.webp';
import heroImage from '../assets/image_Hero.webp';
---

<section class="relative w-full h-[680px] min-h-[680px] overflow-hidden bg-neutres-blanc-casse select-none border-b border-bordures-subtiles">
  
  <!-- Image de fond décorative Fond.webp (Figma node: 342-741) -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden select-none">
    <Image
      src={fondImage}
      alt="Arrière-plan Hero"
      priority
      loading="eager"
      class="w-full h-full object-cover object-center"
    />
  </div>

  <!-- Grand Lettering Arrière-plan "MATTHIS" -->
  <div class="absolute inset-x-0 top-0 sm:top-2 md:top-3 flex justify-center pointer-events-none z-[1] overflow-hidden">
    <h1 class="text-[140px] sm:text-[200px] md:text-[250px] lg:text-[280px] xl:text-[300px] leading-[0.8] tracking-[0.045em] font-londrina font-normal text-marque-orange uppercase whitespace-nowrap">
      MATTHIS
    </h1>
  </div>

  <!-- Image Détourée Portrait agrandie sans dépasser de la section -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 z-10 h-[92%] sm:h-[95%] md:h-[98%] max-h-[670px] pointer-events-none flex justify-center items-end">
    <Image
      src={heroImage}
      alt="Matthis - Portrait"
      priority
      loading="eager"
      class="h-full w-auto max-w-none object-contain object-bottom drop-shadow-[0_10px_32px_rgba(0,0,0,0.25)]"
    />
  </div>

  <!-- Contenu Éditorial Avant-plan (Z-20) calé dans la moitié inférieure -->
  <div class="relative z-20 w-full h-full flex justify-between pt-[290px] sm:pt-[310px] md:pt-[330px] pb-8 md:pb-10 px-4 sm:px-6 md:px-10 pointer-events-auto">
    
    <!-- Colonne Gauche : Montbéliard, 2026, En recherche de stage -->
    <div class="flex flex-col justify-between h-full max-w-[280px] sm:max-w-[320px]">
      <p class="font-londrina font-normal text-[26px] sm:text-[36px] md:text-[44px] lg:text-[48px] leading-none text-marque-orange">
        Montbéliard
      </p>
      
      <p class="font-londrina font-normal text-[26px] sm:text-[36px] md:text-[44px] lg:text-[48px] leading-none text-marque-orange">
        2026
      </p>
      
      <p class="font-londrina font-normal text-[22px] sm:text-[32px] md:text-[40px] lg:text-[48px] leading-[1.05] text-marque-orange">
        En recherche<br />de stage
      </p>
    </div>

    <!-- Colonne Droite : Communication & UI/UX Design, MMI, Scroll -->
    <div class="flex flex-col justify-between items-end text-right h-full max-w-[280px] sm:max-w-[340px]">
      <p class="font-londrina font-normal text-[22px] sm:text-[32px] md:text-[40px] lg:text-[48px] leading-[1.05] text-marque-orange">
        Communication &<br />UI/UX Design
      </p>
      
      <p class="font-londrina font-normal text-[26px] sm:text-[36px] md:text-[44px] lg:text-[48px] leading-none text-marque-orange">
        MMI
      </p>
      
      <a
        href="#projets"
        class="group inline-flex items-center gap-2 font-londrina font-normal text-[20px] sm:text-[24px] leading-none text-marque-orange hover:opacity-80 transition-all pb-1"
        aria-label="Faire défiler vers les projets"
      >
        <span>Scroll</span>
        <svg
          class="w-4 h-4 sm:w-5 sm:h-5 transition-transform group-hover:translate-y-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>

  </div>
</section>
