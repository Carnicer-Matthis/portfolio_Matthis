---
import { Image } from 'astro:assets';
import { projectImageUrl, type ProjectRecord } from '../lib/pocketbase';

interface Props {
  projet: ProjectRecord;
  /** Décalage de l'animation d'apparition (ms), pour faire apparaître les cartes l'une après l'autre */
  revealDelay?: number;
}

const { projet, revealDelay = 0 } = Astro.props;
const imageUrl = projectImageUrl(projet);
const href = `/projets/${projet.id}`;
---

<article data-reveal style={`--reveal-delay: ${revealDelay}ms`} class="group flex flex-col h-full w-full max-w-md mx-auto sm:max-w-none">

  <a href={href} tabindex="-1" aria-hidden="true" class="block">
    <span class="relative block overflow-hidden rounded-xl bg-surfaces-blanc border border-bordures-claires p-1.5 transition duration-300 group-hover:-translate-y-1 group-hover:border-marque-orange group-hover:shadow-[0_12px_24px_-12px_rgba(81,78,76,0.35)]">
      {imageUrl ? (
        <Image
          src={imageUrl}
          inferSize
          alt=""
          format="webp"
          quality={80}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          class="block w-full aspect-17/10 object-cover object-center rounded-lg"
        />
      ) : (
        <span class="flex aspect-17/10 flex-col items-center justify-center text-center">
          <span class="font-londrina text-3xl sm:text-4xl text-marque-orange">{projet.Nom_projet}</span>
          <span class="text-xs text-texte-attenue mt-1">Image à venir</span>
        </span>
      )}
    </span>
  </a>

  <h3 class="mt-5 font-londrina font-normal text-[28px] sm:text-[32px] leading-tight text-neutres-gris-fonce transition-colors group-hover:text-marque-orange">
    <a href={href}>{projet.Nom_projet}</a>
  </h3>

  <span class="mt-2 self-start rounded-full bg-marque-orange/20 px-3 py-0.5 text-[12px] font-medium leading-5 text-neutres-gris-fonce">
    {projet.Parcours}
  </span>

  <p class="mt-3 text-[14px] leading-relaxed text-texte-attenue line-clamp-2">
    {projet.Titre_contexte || projet.Sous_titre}
  </p>

  <div class="mt-auto pt-5">
    <a
      href={href}
      aria-label={`Voir le projet ${projet.Nom_projet}`}
      class="inline-flex items-center rounded-full border border-marque-orange px-5 py-1.5 font-londrina text-[18px] leading-7 text-neutres-gris-fonce transition-colors hover:bg-marque-orange hover:text-texte-principal"
    >
      Voir le projet
    </a>
  </div>

</article>
