---
// Section Réalisations de l'accueil : les projets cochés "Accueil" dans PocketBase
import ProjectCard from './ProjectCard.astro';
import ProjectsUnavailable from './ProjectsUnavailable.astro';
import { getHomeProjects } from '../lib/pocketbase';

// online = false si PocketBase est éteint : on affiche un message au lieu des cartes
const { projects, online } = await getHomeProjects();
---

<section id="projets" class="w-full bg-neutres-blanc-casse py-16 sm:py-20 md:py-24 border-b border-bordures-subtiles">
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16">

    <div class="mb-10 sm:mb-12 md:mb-14 flex flex-wrap items-center justify-between gap-4">
      <div data-reveal>
        <h2 class="font-londrina font-normal text-[38px] sm:text-[54px] md:text-[64px] lg:text-[72px] leading-tight text-neutres-gris-fonce">
          Réalisations
        </h2>
        <div data-reveal="bar" class="w-16 sm:w-20 md:w-24 h-0.75 bg-marque-orange rounded-full mt-2"></div>
      </div>

      <a
        href="/projets"
        class="inline-flex items-center px-5 sm:px-6 py-1.5 sm:py-2 rounded-full border border-marque-orange font-londrina text-[18px] sm:text-[20px] leading-7 text-neutres-gris-fonce hover:bg-marque-orange hover:text-texte-principal transition-colors"
      >
        Plus de projets
      </a>
    </div>

    {online ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 lg:gap-x-10 gap-y-12">
        {projects.map((projet, i) => <ProjectCard projet={projet} revealDelay={i * 120} />)}
      </div>
    ) : (
      <ProjectsUnavailable />
    )}

  </div>
</section>
