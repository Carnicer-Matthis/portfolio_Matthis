---
// Bandeau clair en haut de la page détail (inspiré du Figma node: 340-1748)
import type { ProjectRecord } from '../../lib/pocketbase';

interface Props {
  projet: ProjectRecord;
}

const { projet } = Astro.props;
---

<section class="relative overflow-hidden rounded-xl border border-bordures-claires bg-surfaces-blanc px-6 py-5 sm:px-8 sm:py-6">

  <!-- Ligne du haut : retour + parcours à gauche, lien vers le projet à droite -->
  <div class="relative flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-3 sm:gap-4">
      <a
        href="/projets"
        aria-label="Retour à la liste des projets"
        class="font-londrina text-[18px] leading-6 text-marque-orange transition-opacity hover:opacity-80"
      >
        Retour
      </a>
      <span aria-hidden="true" class="h-4 w-px bg-bordures-claires"></span>
      <p class="inline-flex items-center gap-2 rounded-full bg-marque-orange/15 px-3 py-0.5 text-[12px] leading-5 text-neutres-gris-fonce">
        {projet.Parcours}
      </p>
    </div>

    {projet.URL_resultat && (
      <a
        href={projet.URL_resultat}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-marque-orange px-4 py-1 font-londrina text-[16px] leading-6 text-neutres-gris-fonce transition-colors hover:bg-marque-orange hover:text-texte-principal"
      >
        Voir le site <span aria-hidden="true">↗</span>
        <span class="sr-only">(nouvel onglet)</span>
      </a>
    )}
  </div>

  <!-- Titre + sous-titre -->
  <div class="relative mt-4 max-w-3xl">
    <h1 class="font-londrina font-normal text-[36px] sm:text-[44px] lg:text-[48px] leading-none text-neutres-gris-fonce">
      {projet.Nom_projet}
    </h1>
    <p class="mt-2 text-[14px] sm:text-[15px] leading-snug text-texte-attenue">
      {projet.Sous_titre}
    </p>
  </div>

</section>
