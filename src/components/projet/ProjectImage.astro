---
import { Image } from 'astro:assets';
interface Props {
  src: string | null;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="w-full max-w-215 rounded-xl bg-surfaces-blanc p-1.5">
  {src ? (
    <Image
      src={src}
      inferSize
      alt={alt}
      format="webp"
      quality={80}
      widths={[600, 900, 1300]}
      sizes="(min-width: 1024px) 860px, 100vw"
      loading="eager"
      class="block w-full h-auto rounded-lg"
    />
  ) : (
    <div class="w-full aspect-16/10 rounded-lg bg-neutres-blanc-casse flex items-center justify-center">
      <span class="font-londrina text-4xl text-marque-orange">{alt}</span>
    </div>
  )}
</div>
