---
import { Image, getImage, inferRemoteSize } from 'astro:assets';
import { projectDetailImageUrls, toListHtml, type ProjectRecord } from '../../lib/pocketbase';

interface Props {
  projet: ProjectRecord;
}

const { projet } = Astro.props;

// html: true → le champ PocketBase contient une liste <ul> (éditeur riche)
const infos = [
  { label: 'Rôle', value: projet.Role, html: false },
  { label: 'Outils & technologies', value: projet.Technologies, html: false },
  { label: 'Compétences', value: toListHtml(projet.Competences), html: true },
  { label: 'Équipe', value: projet.Equipe, html: false },
  { label: 'Livrables', value: toListHtml(projet.Livrables), html: true },
].filter((info) => info.value);

// Pour chaque visuel :
// - "large" : version optimisée ouverte au clic (au lieu du fichier brut de PocketBase)
// - "maxWidth" : largeur d'affichage maximale = largeur réelle / 1,5, pour qu'une petite image
//   ne soit jamais agrandie au point d'être floue (reste nette sur les écrans haute densité)
const images = await Promise.all(
  projectDetailImageUrls(projet).map(async (src) => {
    const { width } = await inferRemoteSize(src);
    return {
      src,
      maxWidth: Math.round(width / 1.5),
      large: (await getImage({ src, inferSize: true, width: Math.min(width, 1800), format: 'webp', quality: 82 })).src,
    };
  }),
);
---

<aside class="flex flex-col gap-6">
  {infos.map((info) => (
    <div>
      <p class="font-sans font-semibold text-[10px] leading-[15px] tracking-[1.8px] uppercase text-texte-attenue">
        {info.label}
      </p>
      {info.html ? (
        <div class="info-list mt-1.5 font-sans text-[14px] leading-5 text-texte-principal" set:html={info.value} />
      ) : (
        <p class="mt-1.5 font-sans text-[14px] leading-5 text-texte-principal">{info.value}</p>
      )}
    </div>
  ))}

  {images.length > 0 && (
    <div class="pt-6 border-t-[0.8px] border-bordures-claires">
      <p class="font-sans font-semibold text-[10px] leading-[15px] tracking-[1.8px] uppercase text-texte-attenue">
        Visuels
      </p>
      <ul class="mt-3 flex flex-col gap-5">
        {images.map((image, i) => (
          <li>
            <a
              href={image.large}
              target="_blank"
              rel="noopener"
              style={`max-width: ${image.maxWidth}px`}
              class="detail-img block bg-surfaces-blanc p-1.5 drop-shadow-[0_6px_7px_rgba(0,0,0,0.18)] transition-transform duration-300 hover:-rotate-1 hover:scale-[1.02]"
              aria-label={`Agrandir le visuel ${i + 1} du projet ${projet.Nom_projet} (nouvel onglet)`}
            >
              <Image
                src={image.src}
                inferSize
                alt={`${projet.Nom_projet} — visuel ${i + 1}`}
                format="webp"
                quality={80}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 30vw, 100vw"
                class="detail-img-inner w-full h-auto"
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</aside>

<style>
  /* Effet sticker des visuels, mêmes coins irréguliers que l'image principale */
  .detail-img {
    border-radius: 6px 10px 5px 12px;
  }
  .detail-img-inner {
    border-radius: 3px 7px 3px 9px;
  }

  /* Listes à puces "• Élément" */
  .info-list :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .info-list :global(li::before) {
    content: '• ';
  }
</style>
