---
import '../styles/global.css';

interface Props {
  /** Titre de l'onglet et des résultats Google (≈ 60 caractères max). */
  title?: string;
  /** Résumé affiché sous le titre dans Google (≈ 155 caractères max). */
  description?: string;
}

const {
  title = 'Matthis Carnicer — Portfolio communication & UI/UX design',
  description = "Portfolio de Matthis Carnicer, étudiant en BUT MMI parcours communication à Montbéliard, en recherche de stage. Réalisations en communication, UI/UX design et développement web.",
} = Astro.props;

// URL de la page (devient absolue une fois "site" renseigné dans astro.config.mjs)
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Matthis Carnicer" />
    <meta name="theme-color" content="#f3f0ee" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Aperçu lors d'un partage (LinkedIn, Discord...) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Polices de la maquette : connexion anticipée puis chargement non bloquant (display=swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Londrina+Solid:wght@300;400&display=swap"
    />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-neutres-blanc-casse text-texte-principal font-sans min-h-screen w-full overflow-x-hidden antialiased">
    <!-- Lien d'évitement : visible seulement au clavier (Tab), saute la navigation -->
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-full focus:bg-marque-orange focus:text-surfaces-blanc focus:font-londrina focus:text-[18px]"
    >
      Aller au contenu
    </a>
    <slot />
  </body>
</html>
