---
// Page détail d'un projet (Figma node: 340-1743)
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectBanner from '../../components/projet/ProjectBanner.astro';
import ProjectImage from '../../components/projet/ProjectImage.astro';
import ProjectSidebar from '../../components/projet/ProjectSidebar.astro';
import { getProjects, projectImageUrl, toListHtml, type ProjectRecord } from '../../lib/pocketbase';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((projet, index) => ({
    params: { id: projet.id },
    props: { projet, nextProject: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  projet: ProjectRecord;
  nextProject: ProjectRecord;
}

const { projet, nextProject } = Astro.props;
---

<Layout
  title={`${projet.Nom_projet} — ${projet.Sous_titre} | Matthis Carnicer`}
  description={`${projet.Titre_contexte}. Projet ${projet.Parcours.toLowerCase()} réalisé par Matthis Carnicer : contexte, rôle, solution et résultat.`}
>
  <Header active="projets" />

  <main id="contenu" class="w-full bg-neutres-blanc-casse">
    <!-- Même conteneur que le header : du logo jusqu'au lien Contact (Figma node: 340-1744) -->
    <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16 pt-10 pb-20 lg:pb-28">

      <ProjectBanner projet={projet} />

      <!-- Grille 8 / 4 colonnes (Figma node: 340-1765) -->
      <div id="details" class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-16 scroll-mt-20">

        <article class="lg:col-span-8 lg:pr-10 xl:pr-16 lg:border-r-[0.8px] lg:border-bordures-claires">
          <!-- Image principale (Image_projet) ; les images détail sont dans la sidebar -->
          <ProjectImage src={projectImageUrl(projet)} alt={projet.Nom_projet} />

          <!-- Largeur de lecture confortable, qui suit l'image -->
          <div class="max-w-215">
            <p class="label mt-10">Contexte</p>
            <h2 class="title mt-2">{projet.Titre_contexte}</h2>
            <div class="text mt-3" set:html={projet.Description_contexte} />

            <p class="label mt-8">Problématique</p>
            <div class="text mt-2" set:html={projet.Problematique} />

            <p class="label mt-8">Solution</p>
            <h2 class="title title--small mt-2">{projet.Titre_solution}</h2>
            <div class="solution-list mt-4" set:html={toListHtml(projet.Elements_solution)} />

            <h2 class="title mt-10">Résultat</h2>
            <div class="text mt-2" set:html={projet.Resultat} />

            {projet.URL_resultat && (
              <>
                <p class="label mt-8">Lien</p>
                <a
                  href={projet.URL_resultat}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-flex px-5 py-1.5 rounded-full border-[0.8px] border-marque-orange font-londrina text-[20px] leading-7 text-neutres-gris-fonce hover:bg-marque-orange hover:text-surfaces-blanc transition-colors"
                >
                  Voir le projet
                </a>
              </>
            )}
          </div>
        </article>

        <div class="lg:col-span-4 pt-8 border-t-[0.8px] border-bordures-claires lg:pt-0 lg:border-t-0">
          <ProjectSidebar projet={projet} />
        </div>
      </div>

      <!-- Projet suivant (Figma node: 340-1910) -->
      <nav class="mt-16 pt-6 border-t-[0.8px] border-bordures-claires flex justify-end" aria-label="Navigation entre projets">
        <a
          href={`/projets/${nextProject.id}`}
          class="font-londrina text-[24px] sm:text-[30px] leading-9 text-marque-orange text-right hover:opacity-80 transition-opacity"
        >
          Projet suivant <span class="font-light">—</span> {nextProject.Nom_projet} →
        </a>
      </nav>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../../styles/global.css";

  /* Petites étiquettes en capitales : CONTEXTE, PROBLÉMATIQUE... */
  .label {
    @apply font-sans font-semibold text-[10px] leading-3.75 tracking-[1.8px] uppercase text-texte-attenue;
  }

  /* Titres Londrina */
  .title {
    @apply font-londrina font-normal text-[34px] sm:text-[44px] leading-[0.95] text-neutres-gris-fonce;
  }
  .title--small {
    @apply text-[30px] sm:text-[40px];
  }

  /* Paragraphes (contenu PocketBase) */
  .text {
    @apply font-sans text-[15px] leading-[24.375px] xl:text-[16px] xl:leading-[26px] text-texte-principal;
  }
  .text :global(p + p) {
    margin-top: 0.75rem;
  }

  /* Liste Solution avec cases cochées orange (Figma node: 340-1790) */
  .solution-list :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .solution-list :global(li) {
    position: relative;
    padding-left: 32px;
    font-size: 15px;
    line-height: 20.625px;
    color: var(--texte-principal);
  }
  .solution-list :global(li::before) {
    content: '✓';
    position: absolute;
    left: 0;
    top: 2px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: var(--marque-orange);
    background: rgb(250 133 90 / 0.15);
    border: 0.8px solid var(--marque-orange);
    border-radius: 4px;
  }
</style>
