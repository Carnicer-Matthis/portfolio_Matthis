export async function getStaticPaths() {
  const PB_URL = 'http://127.0.0.1:8090';
  let projects: ProjectRecord[] = [];

  try {
    const res = await fetch(`${PB_URL}/api/collections/Projet/records?sort=Numero`, {
      signal: AbortSignal.timeout(2000)
    });
    if (res.ok) {
      const data = await res.json();
      if (data.items && data.items.length > 0) {
        projects = data.items;
      }
    }
  } catch (error) {
    console.warn("PocketBase non disponible lors du build, utilisation des données de secours.");
  }

  if (!projects.length) {
    projects = fallbackProjects;
  }

  return projects.map((projet, index) => {
    const nextProject = projects[(index + 1) % projects.length];
    const prevProject = projects[(index - 1 + projects.length) % projects.length];

    return {
      params: { id: projet.id },
      props: { projet, nextProject, prevProject }
    };
  });
}

interface Props {
  projet: ProjectRecord;
  nextProject: ProjectRecord;
  prevProject: ProjectRecord;
}

const { projet, nextProject } = Astro.props;

const numFormatted = String(projet.Numero).padStart(2, '0');
const imageUrl = projet.Image_projet
  ? `${PB_URL}/api/files/${projet.collectionId}/${projet.id}/${projet.Image_projet}`
  : null;
---

<Layout title={`${projet.Nom_projet} — Matthis Carnicer`}>
  <Header active="projets" />

  <main class="w-full bg-neutres-blanc-casse min-h-screen py-8 sm:py-12 md:py-16">
    <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16">
      
      <!-- Lien retour (Figma node: 340-1746) -->
      <div class="mb-6 sm:mb-8">
        <a
          href="/#projets"
          class="inline-flex items-center gap-2 font-londrina font-normal text-[20px] sm:text-[22px] text-marque-orange hover:opacity-80 transition-opacity select-none"
        >
          <span>← Explorations & Chantiers</span>
        </a>
      </div>

      <!-- Bandeau Titre Sombre (Figma node: 340-1748) -->
      <section class="w-full bg-[#514E4C] rounded-[4px] px-6 sm:px-8 py-5 sm:py-6 mb-10 sm:mb-14 text-neutres-blanc-casse select-none shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          
          <!-- Groupe Gauche : Numéro + Titre + Sous-titre -->
          <div class="flex flex-wrap items-baseline gap-x-4 sm:gap-x-5 gap-y-1">
            <span class="font-londrina font-normal text-[48px] sm:text-[60px] leading-none text-marque-orange">
              {numFormatted}
            </span>
            <h1 class="font-londrina font-normal text-[40px] sm:text-[54px] md:text-[56px] leading-none text-neutres-blanc-casse">
              {projet.Nom_projet}
            </h1>
            <span class="font-sans text-[13px] sm:text-[14px] text-neutres-blanc-casse/85 self-center">
              {projet.Sous_titre}
            </span>
          </div>

          <!-- Groupe Droit : Parcours + Flèche Défilement -->
          <div class="flex items-center gap-4 sm:gap-5 self-end md:self-center">
            <span class="font-sans text-[13px] sm:text-[14px] text-neutres-blanc-casse/90">
              {projet.Parcours}
            </span>
            <a
              href="#details"
              class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-neutres-blanc-casse/70 flex items-center justify-center text-neutres-blanc-casse text-base hover:border-marque-orange hover:text-marque-orange transition-colors"
              aria-label="Défiler vers le contenu"
            >
              ↓
            </a>
          </div>

        </div>
      </section>

      <!-- Grille Principale 2 Colonnes (Contenu 8 cols / Sidebar 4 cols) -->
      <div id="details" class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <!-- Colonne Principale Gauche (8 colonnes) -->
        <article class="lg:col-span-8 flex flex-col space-y-10 sm:space-y-12">
          
          <!-- Vignette / Image du Projet avec Effet Sticker (Figma node: 340-1768) -->
          <div class="w-full aspect-[16/10] rounded-[12px] shadow-[0_6px_14px_rgba(0,0,0,0.18)] overflow-hidden flex items-center justify-center">
            {imageUrl ? (
              <img
                src={imageUrl}
                alt={`Image du projet ${projet.Nom_projet}`}
                class="w-full h-full object-cover rounded-[12px]"
              />
            ) : (
              <div class="w-full h-full bg-surfaces-blanc rounded-[12px] flex items-center justify-center p-6 text-center">
                <span class="font-londrina text-4xl text-marque-orange">{projet.Nom_projet}</span>
              </div>
            )}
          </div>

          <!-- Section Contexte (Figma nodes: 340-1772, 340-1774, 340-1776) -->
          <section>
            <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-1">
              Contexte
            </span>
            <h2 class="font-londrina font-normal text-[32px] sm:text-[40px] md:text-[44px] leading-[1.05] text-[#2B2927] mb-3">
              {projet.Titre_contexte}
            </h2>
            <div
              class="font-sans text-[15px] sm:text-[16px] leading-relaxed text-[#2B2927] space-y-3 prose max-w-none"
              set:html={projet.Description_contexte}
            />
          </section>

          <!-- Section Problématique (Figma nodes: 340-1778, 340-1780) -->
          <section>
            <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-1">
              Problématique
            </span>
            <div
              class="font-sans text-[15px] sm:text-[16px] leading-relaxed text-[#2B2927] space-y-3 prose max-w-none"
              set:html={projet.Problematique}
            />
          </section>

          <!-- Section Solution (Figma nodes: 340-1782, 340-1784, 340-1786) -->
          <section>
            <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-1">
              Solution
            </span>
            <h2 class="font-londrina font-normal text-[28px] sm:text-[36px] md:text-[40px] leading-[1.05] text-[#2B2927] mb-4">
              {projet.Titre_solution}
            </h2>
            <div
              class="solution-list font-sans text-[15px] sm:text-[16px] leading-relaxed text-[#2B2927]"
              set:html={projet.Elements_solution}
            />
          </section>

          <!-- Section Résultat (Figma nodes: 340-1833, 340-1835) -->
          <section>
            <h2 class="font-londrina font-normal text-[32px] sm:text-[40px] md:text-[44px] leading-[1.05] text-[#2B2927] mb-2">
              Résultat
            </h2>
            <div
              class="font-sans text-[15px] sm:text-[16px] leading-relaxed text-[#2B2927] space-y-3 prose max-w-none"
              set:html={projet.Resultat}
            />
          </section>

          <!-- Bouton Lien vers le projet (Figma node: 340-1837) -->
          {projet.URL_resultat && (
            <section class="pt-2">
              <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-3">
                Lien
              </span>
              <a
                href={projet.URL_resultat}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-6 py-2 rounded-full border border-marque-orange font-londrina font-normal text-[18px] sm:text-[20px] text-[#2B2927] hover:bg-marque-orange hover:text-surfaces-blanc transition-all"
              >
                Voir le projet
              </a>
            </section>
          )}

        </article>

        <!-- Colonne Sidebar Droite (4 colonnes - Figma node: 340-1840) -->
        <aside class="lg:col-span-4 bg-surfaces-blanc/40 p-6 sm:p-7 rounded-[12px] border border-bordures-subtiles/60 space-y-6 select-none">
          
          <!-- Rôle -->
          <div>
            <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-1">
              Rôle
            </span>
            <p class="font-sans text-[14px] text-[#2B2927]">
              {projet.Role}
            </p>
          </div>

          <!-- Outils & technologies -->
          <div class="pt-5 border-t border-bordures-subtiles">
            <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-1">
              Outils & technologies
            </span>
            <p class="font-sans text-[14px] text-[#2B2927]">
              {projet.Technologies}
            </p>
          </div>

          <!-- Compétences -->
          <div class="pt-5 border-t border-bordures-subtiles">
            <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-1">
              Compétences
            </span>
            <div
              class="sidebar-list font-sans text-[14px] text-[#2B2927]"
              set:html={projet.Competences}
            />
          </div>

          <!-- Équipe -->
          <div class="pt-5 border-t border-bordures-subtiles">
            <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-1">
              Équipe
            </span>
            <p class="font-sans text-[14px] text-[#2B2927]">
              {projet.Equipe}
            </p>
          </div>

          <!-- Livrables -->
          <div class="pt-5 border-t border-bordures-subtiles">
            <span class="block font-sans font-semibold text-[10px] sm:text-[11px] text-[#6F6A64] tracking-wider uppercase mb-1">
              Livrables
            </span>
            <div
              class="sidebar-list font-sans text-[14px] text-[#2B2927]"
              set:html={projet.Livrables}
            />
          </div>

        </aside>

      </div>

      <!-- Lien Projet Suivant (Figma node: 340-1916) -->
      <nav class="border-t border-bordures-subtiles pt-8 mt-14 sm:mt-20 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4" aria-label="Navigation entre projets">
        <a
          href="/#projets"
          class="font-londrina font-normal text-[18px] sm:text-[20px] text-[#6F6A64] hover:text-marque-orange transition-colors"
        >
          ← Retour aux réalisations
        </a>

        {nextProject && (
          <a
            href={`/projets/${nextProject.id}`}
            class="font-londrina font-normal text-[22px] sm:text-[28px] md:text-[30px] text-marque-orange hover:opacity-85 transition-opacity"
          >
            Projet suivant — {nextProject.Nom_projet} →
          </a>
        )}
      </nav>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Mise en forme de la liste avec coches oranges pour les solutions */
  .solution-list :global(ul) {
    list-style: none;
    padding-left: 0;
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .solution-list :global(li) {
    position: relative;
    padding-left: 1.75rem;
  }
  .solution-list :global(li::before) {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-marque-orange, #fa855a);
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* Mise en forme des listes à puces de la sidebar */
  .sidebar-list :global(ul) {
    list-style: none;
    padding-left: 0;
    margin-top: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sidebar-list :global(li) {
    position: relative;
    padding-left: 1rem;
  }
  .sidebar-list :global(li::before) {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-marque-orange, #fa855a);
  }
  .sidebar-list :global(p) {
    margin-bottom: 0.25rem;
  }
</style>

