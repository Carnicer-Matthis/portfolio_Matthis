---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectsUnavailable from '../../components/ProjectsUnavailable.astro';
import { getProjectsResult } from '../../lib/pocketbase';

// online = false si PocketBase est éteint : on affiche un message au lieu des cartes
const { projects, online } = await getProjectsResult();

// Un projet "Communication / Design" apparaît dans les deux filtres.
const filters = [
  { id: 'tout', label: 'Tout' },
  { id: 'développement web', label: 'Développement web' },
  { id: 'communication', label: 'Communication' },
  { id: 'design', label: 'Design' },
];
---

<Layout
  title="Mes projets — Matthis Carnicer"
  description="Toutes les réalisations de Matthis Carnicer : communication, design et développement web. Contexte, recherches et résultat de chaque projet."
>
  <Header active="projets" />

  <main id="contenu" class="w-full bg-neutres-blanc-casse pt-12 sm:pt-16 pb-20 sm:pb-28">
    <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-10 lg:px-16">

      <h1 class="font-londrina font-normal text-[56px] sm:text-[76px] md:text-[96px] leading-[0.9] text-neutres-gris-fonce">
        Mes projets
      </h1>
      <div data-reveal="bar" class="w-20 sm:w-24 h-0.75 bg-marque-orange rounded-full mt-3"></div>

      <p class="font-sans font-medium text-[15px] leading-[22.5px] text-texte-principal max-w-[620px] mt-6">
        Voici la liste de mes projets réalisés, vous pouvez voir ici le contexte, les recherches et le résultat des réalisations.
      </p>
      <p class="font-sans text-[12px] leading-4 text-texte-attenue mt-1">
        D’autres réalisations existent. Cette page est susceptible de changer
      </p>

      <hr class="border-0 border-t-[0.8px] border-marque-orange mt-6" />

      {projects.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-6" role="group" aria-label="Filtrer les projets par parcours">
          {filters.map((filter, i) => (
            <button
              type="button"
              data-filter={filter.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="filter-btn"
            >
              {filter.label}
            </button>
          ))}
        </div>
      )}

      {projects.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10 mt-6">
          {projects.map((projet, i) => (
            <div data-parcours={projet.Parcours.toLowerCase()} class="project-item">
              <ProjectCard projet={projet} revealDelay={(i % 3) * 120} />
            </div>
          ))}
        </div>
      ) : online ? (
        <p class="font-sans text-[14px] text-texte-attenue mt-10">Les projets arrivent bientôt.</p>
      ) : (
        <div class="mt-6">
          <ProjectsUnavailable />
        </div>
      )}

      <p id="no-result" class="hidden font-sans text-[14px] text-texte-attenue mt-10">
        Aucun projet dans cette catégorie pour le moment.
      </p>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const noResult = document.getElementById('no-result');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'tout';

      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

      let visibleCount = 0;
      items.forEach((item) => {
        const visible = filter === 'tout' || (item.dataset.parcours ?? '').includes(filter);
        item.classList.toggle('hidden', !visible);
        if (visible) {
          // Rejoue l'animation d'apparition de la carte, en cascade
          const card = item.querySelector<HTMLElement>('[data-reveal]');
          if (card) {
            card.style.setProperty('--reveal-delay', `${(visibleCount % 3) * 80}ms`);
            card.classList.remove('is-visible');
            void card.offsetWidth; // force le navigateur à repartir de l'état caché
            card.classList.add('is-visible');
          }
          visibleCount++;
        }
      });

      noResult?.classList.toggle('hidden', visibleCount > 0);
    });
  });
</script>

<style>
  @reference "../../styles/global.css";

  /* Onglets de filtre */
  .filter-btn {
    @apply h-[25.6px] px-3 rounded-full border-[0.8px] border-bordures-claires
      font-sans font-medium text-[11px] leading-5 text-texte-attenue
      hover:border-marque-orange hover:text-marque-orange transition-colors cursor-pointer
      focus:outline-none focus-visible:ring-2 focus-visible:ring-marque-orange focus-visible:ring-offset-2;
  }
  .filter-btn[aria-pressed='true'] {
    @apply bg-marque-orange border-texte-principal/20 text-texte-principal;
  }
</style>
